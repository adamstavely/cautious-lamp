{
  "name": "@adamstavely/loupe-tool",
  "version": "1.0.0",
  "description": "Standalone Loupe Tool for inspecting design system components in any application",
  "main": "dist/loupe-tool.umd.js",
  "module": "dist/loupe-tool.es.mjs",
  "unpkg": "dist/loupe-tool.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/loupe-tool.es.mjs",
      "require": "./dist/loupe-tool.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:pack": "npm run build && node scripts/check-pack.mjs",
    "prepublishOnly": "npm run build && node scripts/check-pack.mjs"
  },
  "keywords": [
    "design-system",
    "loupe",
    "inspector",
    "components",
    "dev-tools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamstavely/cautious-lamp.git",
    "directory": "loupe-tool-standalone"
  },
  "homepage": "https://github.com/adamstavely/cautious-lamp/tree/main/loupe-tool-standalone#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "lucide-vue-next": "^0.552.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.5",
    "vue": "^3.3.4"
  }
}
