{
  "name": "@designsystem/loupe-tool",
  "version": "1.0.0",
  "description": "Standalone Loupe Tool for inspecting design system components in any application",
  "main": "dist/loupe-tool.umd.js",
  "module": "dist/loupe-tool.es.mjs",
  "unpkg": "dist/loupe-tool.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/loupe-tool.es.mjs",
      "require": "./dist/loupe-tool.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:pack": "npm run build && node scripts/check-pack.mjs",
    "prepublishOnly": "npm run build && node scripts/check-pack.mjs"
  },
  "keywords": [
    "design-system",
    "loupe",
    "inspector",
    "components",
    "dev-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lucide-vue-next": "^0.552.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.4.0",
    "vite": "^5.0.0",
    "vue": "^3.3.4"
  }
}
