{
  "name": "design-system-extension",
  "displayName": "Design System",
  "description": "Design System integration for VS Code - autocomplete, hover info, snippets, and more",
  "version": "1.0.0",
  "publisher": "design-system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamstavely/cautious-lamp.git",
    "directory": "vscode-design-system-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Design System",
      "properties": {
        "designSystem.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000/api/v1",
          "description": "Design System API URL"
        },
        "designSystem.apiKey": {
          "type": "string",
          "default": "",
          "description": "Design System API key, sent as a Bearer token. Every API route needs one."
        },
        "designSystem.enableAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable autocomplete for design tokens and components"
        },
        "designSystem.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover information for tokens and components"
        },
        "designSystem.enableColorPreview": {
          "type": "boolean",
          "default": true,
          "description": "Show color previews inline"
        },
        "designSystem.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Offer the Design System code snippets (ds-button, ds-color, …) in completions."
        },
        "designSystem.tokenImportPath": {
          "type": "string",
          "default": "",
          "description": "Module that exports `tokens`, for quick fixes in JavaScript/TypeScript strings: they write `tokens.color.primary` and add `import { tokens } from '<this>'` when the file doesn't import tokens yet. Leave empty to write `var(--color-primary)` inside the string instead. In CSS, quick fixes always write `var(--token-name)`."
        },
        "designSystem.requestTimeout": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "How long to wait for the API, in milliseconds. Timeouts, dropped connections and 5xx answers are retried twice; 4xx answers are not."
        },
        "designSystem.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Warn about hard-coded colours and spacing that equal a design token, with a quick fix to replace them."
        },
        "designSystem.docsBaseUrl": {
          "type": "string",
          "default": "http://localhost:5174",
          "description": "URL of the Design System app. \"Open Component Documentation\" opens a component's page there (/components/buttons, /components/color-picker), or the component library (/components) for components without their own page."
        }
      }
    },
    "commands": [
      {
        "command": "designSystem.insertComponent",
        "title": "Insert Component",
        "category": "Design System"
      },
      {
        "command": "designSystem.insertToken",
        "title": "Insert Token",
        "category": "Design System"
      },
      {
        "command": "designSystem.openComponentDocs",
        "title": "Open Component Documentation",
        "category": "Design System"
      },
      {
        "command": "designSystem.replaceWithToken",
        "title": "Replace with Design Token",
        "category": "Design System"
      },
      {
        "command": "designSystem.refreshCache",
        "title": "Refresh Design System Cache",
        "category": "Design System"
      },
      {
        "command": "designSystem.showOutput",
        "title": "Show Output",
        "category": "Design System"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "designSystem.replaceWithToken",
          "when": "editorHasSelection && editorTextFocus",
          "group": "designSystem"
        },
        {
          "command": "designSystem.openComponentDocs",
          "when": "editorTextFocus",
          "group": "designSystem"
        }
      ],
      "commandPalette": [
        {
          "command": "designSystem.insertComponent",
          "when": "editorTextFocus"
        },
        {
          "command": "designSystem.insertToken",
          "when": "editorTextFocus"
        },
        {
          "command": "designSystem.openComponentDocs",
          "when": "editorTextFocus"
        },
        {
          "command": "designSystem.replaceWithToken",
          "when": "editorHasSelection && editorTextFocus"
        },
        {
          "command": "designSystem.refreshCache"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out design-system-extension.vsix --baseContentUrl https://github.com/adamstavely/cautious-lamp/blob/main/vscode-design-system-extension/ --baseImagesUrl https://github.com/adamstavely/cautious-lamp/raw/main/vscode-design-system-extension/",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.80.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^3.2.1"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
