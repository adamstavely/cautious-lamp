# Copy to backend/.env for local development.

PORT=3000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# API keys for machine clients (MCP server, CLI, ESLint plugin, CI), accepted on
# Authorization: Bearer <key>, comma-separated. The browser signs in instead.
API_KEYS=change-me-local-dev-key
# Key for admin-only routes (API key management, review administration)
ADMIN_API_KEY=change-me-admin-key

# Sign-in for people (docs/AUTH.md)
# Signs access tokens (HS256, 8 hours). Required unless NODE_ENV is development
# or test, where a random one is generated per process (sign-ins end on restart).
# Generate one with: openssl rand -hex 32
AUTH_JWT_SECRET=
# When there are no users yet, the first admin is created from these. They must
# change the password on first sign-in. The password needs 12+ characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional display name for that admin
BOOTSTRAP_ADMIN_NAME=

# Required outside development: encrypts stored third-party tokens. Use 64 hex
# characters (openssl rand -hex 32); other values are treated as a passphrase.
# Must be the same on every replica (docs/AUTH.md, "Encryption key").
ENCRYPTION_KEY=

# Notification delivery (docs/NOTIFICATIONS.md). Without SMTP, email is shown
# as "not set up on this server" and nothing is emailed; Slack, Teams and
# webhooks need only outbound HTTPS.
# Either a connection URL:
#   SMTP_URL=smtps://user:password@smtp.example.com:465
# or host settings (SMTP_SECURE=true for TLS from the start; defaults to true on port 465):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=
#   SMTP_PASS=
# The sender, required with either
SMTP_URL=
SMTP_FROM=
# The frontend's public origin, for links in delivered messages. Without it
# messages carry no link.
APP_PUBLIC_URL=http://localhost:5174

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Optional: enables the alt text generator, Eero (the design system chat) and
# AI suggestions (Claude API). Without it they say they're not configured.
ANTHROPIC_API_KEY=
# Claude calls per person per minute for Eero and AI suggestions (default 10)
# AI_REQUESTS_PER_MINUTE=10

OTEL_ENABLED=false

# Design reviews (docs/REVIEW_API.md)
# Signs the short-lived review file URLs (HMAC-SHA256). Required unless
# NODE_ENV is development or test, where a random one is generated per process.
# Generate one with: openssl rand -hex 32
REVIEW_FILE_SECRET=
# Local development only; leave unset (or production) in deployed environments
NODE_ENV=development
# Where uploaded review files are stored, one folder per review
REVIEW_UPLOAD_DIR=uploads/reviews
# Public origin of this API, used to build upload and signed file URLs.
# Defaults to the origin of the incoming request.
PUBLIC_API_URL=http://localhost:3000

# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=600

# IRIS photosensitivity analysis (docs/INTEGRATIONS.md). The backend Docker
# image includes IRIS and sets these; outside it, point them at your IrisApp
# build and IRIS's config/appsettings.json.
IRIS_EXECUTABLE_PATH=
IRIS_CONFIG_PATH=
# Per video, in milliseconds (default 10 minutes). IrisApp is killed (SIGKILL)
# and its files deleted when it runs longer.
IRIS_TIMEOUT_MS=
# Limits on analysis work (docs/IRIS_PHOTOSENSITIVITY_SERVICE.md#limits).
# IrisApp processes running at once (default 2)
IRIS_MAX_CONCURRENT=
# Analyses admitted beyond those running: waiting for a slot or still
# uploading (default 4). Past that, POST /analyze answers 503
# PHOTOSENSITIVITY_BUSY before the upload is written.
IRIS_MAX_QUEUED=
# Analyses one user or API key may have running or queued (default 2). Past
# that, 429 PHOTOSENSITIVITY_QUOTA_EXCEEDED.
IRIS_MAX_PER_CALLER=
# The Retry-After sent with those refusals, in seconds (default 30)
IRIS_RETRY_AFTER_SECONDS=
# Videos with more frames than this are refused (default 216000, an hour at 60fps)
IRIS_MAX_FRAMES=
# IRIS results (framedata.csv) larger than this are refused unread (default 67108864, 64MB)
IRIS_MAX_OUTPUT_BYTES=

# Scheduled governance scans and accessibility reports (docs/GOVERNANCE.md).
# A run holds a lease; if its instance dies, another takes over once it
# expires. Failed runs are retried with doubling delays, then dead-lettered.
# Defaults: lease 600000 (10 min), 3 attempts, first retry after 300000 (5 min).
GOVERNANCE_SCHEDULER_LEASE_MS=
GOVERNANCE_SCHEDULER_MAX_ATTEMPTS=
GOVERNANCE_SCHEDULER_RETRY_DELAY_MS=
A11Y_SCHEDULER_LEASE_MS=
A11Y_SCHEDULER_MAX_ATTEMPTS=
A11Y_SCHEDULER_RETRY_DELAY_MS=

# Delivery attempts (docs/NOTIFICATIONS.md) older than this many days are
# deleted once a day (default 90). One replica does it, under a lease
# (DELIVERY_RETENTION_LEASE_MS, default 600000). DELIVERY_RETENTION_ENABLED=false
# turns it off; DELIVERY_RETENTION_INTERVAL_MS is how often it checks (default 3600000).
DELIVERY_ATTEMPT_RETENTION_DAYS=
DELIVERY_RETENTION_ENABLED=

# Contributions (Getting started > Contribute) open pull requests in this
# repository. Without these, the page gives the pull request text to paste.
# The token needs Contents and Pull requests write access to the repository
# (a fine-grained personal access token, or a GitHub App installation token).
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# Optional: the branch pull requests target (default: the repository's default branch)
GITHUB_BASE_BRANCH=
# Optional: GitHub Enterprise Server's API, e.g. https://github.example.com/api/v3
GITHUB_API_URL=
