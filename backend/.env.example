# Copy to backend/.env for local development.

PORT=3000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# API keys for machine clients (MCP server, CLI, ESLint plugin, CI), accepted on
# Authorization: Bearer <key>, comma-separated. The browser signs in instead.
API_KEYS=change-me-local-dev-key
# Key for admin-only routes (API key management, review administration)
ADMIN_API_KEY=change-me-admin-key

# Sign-in for people (docs/AUTH.md)
# Signs access tokens (HS256, 8 hours). Required unless NODE_ENV is development
# or test, where a random one is generated per process (sign-ins end on restart).
# Generate one with: openssl rand -hex 32
AUTH_JWT_SECRET=
# When there are no users yet, the first admin is created from these. They must
# change the password on first sign-in. The password needs 12+ characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional display name for that admin
BOOTSTRAP_ADMIN_NAME=

# Required outside development: encrypts stored third-party tokens
ENCRYPTION_KEY=

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Optional: enables the alt text generator (Claude API)
ANTHROPIC_API_KEY=

OTEL_ENABLED=false

# Design reviews (docs/REVIEW_API.md)
# Signs the short-lived review file URLs (HMAC-SHA256). Required unless
# NODE_ENV is development or test, where a random one is generated per process.
# Generate one with: openssl rand -hex 32
REVIEW_FILE_SECRET=
# Local development only; leave unset (or production) in deployed environments
NODE_ENV=development
# Where uploaded review files are stored, one folder per review
REVIEW_UPLOAD_DIR=uploads/reviews
# Public origin of this API, used to build upload and signed file URLs.
# Defaults to the origin of the incoming request.
PUBLIC_API_URL=http://localhost:3000

# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=600
