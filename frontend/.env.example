# Copy to frontend/.env for local development.

# Backend origin. Leave empty to use the Vite dev server's /api proxy.
VITE_API_BASE_URL=
# Must be one of the backend's API_KEYS
VITE_API_KEY=change-me-local-dev-key
# Set to true to run the review section against browser-only mock data
VITE_USE_MOCKS=false
