# Copy to frontend/.env for local development.

# Backend origin. Leave empty to use the Vite dev server's /api proxy.
VITE_API_BASE_URL=
# People sign in with email and password (docs/AUTH.md); the browser holds no API key.
# Set to true to run without a backend: a local demo user with every permission
# is signed in, and the review section uses browser-only mock data.
VITE_USE_MOCKS=false
