{
  "name": "@designsystem/api",
  "version": "1.0.0",
  "description": "JavaScript SDK for Design System API",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc && tsc --module esnext --declaration false --outDir dist/esm && node scripts/esm-package.js",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "design-system",
    "tokens",
    "components",
    "api",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "files": [
    "dist"
  ]
}
