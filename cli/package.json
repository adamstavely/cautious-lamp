{
  "name": "@designsystem/cli",
  "version": "1.0.0",
  "description": "CLI tool for Design System API",
  "bin": {
    "ds": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc && node scripts/make-executable.js",
    "pretest": "npm run build",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "design-system",
    "cli",
    "tokens",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@designsystem/api": "^1.0.0",
    "commander": "^11.0.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.3.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 30000,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "files": [
    "dist"
  ]
}
