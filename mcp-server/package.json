{
  "name": "@adamstavely/design-system-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Design System Platform - exposes design system resources via Model Context Protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "design-system-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bundled-docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:e2e": "jest --testPathPattern=test/e2e",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "bundle-docs": "node scripts/bundle-docs.js",
    "prepack": "npm run build && npm run bundle-docs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "ai",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamstavely/cautious-lamp.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/adamstavely/cautious-lamp/tree/main/mcp-server#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node-cache": "^4.1.3",
    "axios": "^1.6.0",
    "node-cache": "^5.1.2",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.3.1",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
